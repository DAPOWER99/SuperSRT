# ============================================
# SUPER SRT ENVIRONMENT CONFIGURATION
# Version: 2.0.0 (FREE MODELS OPTIMIZED)
# License: MIT
# ============================================

# --------------------------------------------
# REQUIRED - OpenRouter API Configuration
# --------------------------------------------
# Get your API key from: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# AI Model Configuration (OPTIMIZED FREE MODELS)
# --------------------------------------------
# Default models for different tasks - All FREE!
# These are the best free models available on OpenRouter

# Primary Models
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
TRANSLATION_MODEL=google/gemini-2.0-flash-exp:free
IMPROVEMENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
SUMMARIZATION_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
ANALYSIS_MODEL=anthropic/claude-3-haiku-20240307:free
FAST_MODEL=mistralai/mistral-small-24b-instruct-2501:free
BALANCED_MODEL=qwen/qwen3-32b:free
CREATIVE_MODEL=z-ai/glm-4.5-air:free
CODE_MODEL=openai/gpt-oss-120b:free
FALLBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Model parameters
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
MODEL_TOP_P=0.9
MODEL_FREQUENCY_PENALTY=0.0
MODEL_PRESENCE_PENALTY=0.0
MODEL_TIMEOUT=60
MODEL_RETRY_ATTEMPTS=3

# Model selection strategy
# Options: auto, quality, speed, balanced
MODEL_SELECTION_STRATEGY=auto

# --------------------------------------------
# Cache Configuration
# --------------------------------------------
CACHE_ENABLED=true
CACHE_LOCATION=./cache
CACHE_TTL=86400  # 24 hours in seconds
CACHE_MAX_SIZE=1073741824  # 1GB
CACHE_COMPRESSION=true
CACHE_ENCRYPTION=false

# Redis Cache (optional - for distributed caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# --------------------------------------------
# Output Configuration
# --------------------------------------------
OUTPUT_DIR=./output
DEFAULT_FORMAT=srt
OUTPUT_ENCODING=utf-8
AUTO_BACKUP=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
OVERWRITE_WARNING=true

# --------------------------------------------
# Performance Configuration
# --------------------------------------------
PARALLEL_WORKERS=4
CHUNK_SIZE=1000
MAX_FILE_SIZE=104857600  # 100MB
MEMORY_LIMIT=8589934592  # 8GB
IO_BUFFER_SIZE=8192
TIMEOUT_SECONDS=300
BATCH_PROCESSING_SIZE=10

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/supersrt.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
CONSOLE_LOGGING=true
LOG_JSON_FORMAT=false

# --------------------------------------------
# Feature Flags
# --------------------------------------------
# AI Features
ENABLE_AI_TRANSLATION=true
ENABLE_AI_IMPROVEMENT=true
ENABLE_AI_SUMMARIZATION=true
ENABLE_AI_ANALYSIS=true
ENABLE_AI_GRAMMAR=true
ENABLE_AI_CONSISTENCY=true
ENABLE_AI_FORMATTING=true
ENABLE_AI_EMOTION=true
ENABLE_AI_CULTURAL=true
ENABLE_AI_READABILITY=true

# Processing Features
ENABLE_BATCH_PROCESSING=true
ENABLE_INTERACTIVE_MODE=true
ENABLE_TUI=true
ENABLE_API_SERVER=false
ENABLE_WEB_UI=false
ENABLE_AUDIO_PROCESSING=true
ENABLE_SPEECH_RECOGNITION=true

# Advanced Features
ENABLE_PIPELINE=true
ENABLE_ENHANCEMENT=true
ENABLE_SYNC=true
ENABLE_ADAPTATION=true
ENABLE_EXPERIMENTAL=false

# --------------------------------------------
# Audio Processing Configuration
# --------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FORMAT=wav
SPEECH_RECOGNITION_LANGUAGE=en-US
SILENCE_THRESHOLD=0.01
MIN_SPEECH_DURATION=1.0
MAX_SPEECH_GAP=0.5

# --------------------------------------------
# API Server Configuration
# --------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_MAX_REQUESTS=100
API_RATE_LIMIT=60
API_AUTH_REQUIRED=false
API_API_KEY=your-api-key-here
API_CORS_ORIGINS=*
API_CACHE_TTL=300
API_ENABLE_HTTPS=false
API_SSL_CERT=
API_SSL_KEY=

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DATABASE_TYPE=sqlite  # Options: sqlite, postgresql, mysql
DATABASE_URL=sqlite:///./supersrt.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
DATABASE_TIMEOUT=30

# PostgreSQL (optional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supersrt
POSTGRES_USER=supersrt
POSTGRES_PASSWORD=supersrt_secure_password

# --------------------------------------------
# Security Configuration
# --------------------------------------------
SECURE_FILE_PERMISSIONS=true
SANITIZE_FILENAMES=true
ALLOW_REMOTE_URLS=false
ENABLE_SANDBOX=false
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=.srt,.vtt,.ass,.ssa,.ttml,.sbv,.smi,.txt,.json,.csv,.xml
RESTRICTED_COMMANDS=false
ENABLE_FILE_VALIDATION=true

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
RATE_LIMIT_TRANSLATIONS=100
RATE_LIMIT_IMPROVEMENTS=50
RATE_LIMIT_ANALYSIS=200
RATE_LIMIT_AI_CALLS=500
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_RESET_INTERVAL=3600

# --------------------------------------------
# Integration Settings
# --------------------------------------------
VLC_PLUGIN_ENABLED=false
MPC_PLUGIN_ENABLED=false
KODI_PLUGIN_ENABLED=false
PLEX_PLUGIN_ENABLED=false
EMBY_PLUGIN_ENABLED=false

# VLC Integration
VLC_EXECUTABLE_PATH=/usr/bin/vlc
VLC_PLUGIN_DIR=./plugins/vlc

# --------------------------------------------
# Proxy Configuration (Optional)
# --------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
USE_PROXY=false

# --------------------------------------------
# Development Mode
# --------------------------------------------
DEV_MODE=false
DEBUG=false
PROFILE_ENABLED=false
TESTING=false
COVERAGE=false
VERBOSE=false
PRETTY_PRINT=false

# --------------------------------------------
# Optional Service API Keys (Fallback)
# --------------------------------------------
# Google Translate API (fallback)
GOOGLE_TRANSLATE_API_KEY=

# DeepL API (fallback)
DEEPL_API_KEY=

# OpenAI API (fallback)
OPENAI_API_KEY=

# Anthropic API (fallback)
ANTHROPIC_API_KEY=

# AWS Services (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --------------------------------------------
# Custom Model Endpoints
# --------------------------------------------
CUSTOM_MODEL_ENDPOINT=
CUSTOM_MODEL_API_KEY=
CUSTOM_MODEL_NAME=

# --------------------------------------------
# Advanced Settings
# --------------------------------------------
# Enable experimental features at your own risk
EXPERIMENTAL_FEATURES=false
UNSAFE_OPERATIONS=false
ALLOW_SYSTEM_COMMANDS=false
ENABLE_NETWORK_FEATURES=true

# Model Caching
MODEL_CACHING_ENABLED=true
MODEL_CACHE_TTL=3600

# Model Fallback
ENABLE_MODEL_FALLBACK=true
MODEL_FALLBACK_TIMEOUT=30

# --------------------------------------------
# Docker Configuration (if using Docker)
# --------------------------------------------
DOCKER_MODE=false
CONTAINER_NAME=supersrt
DOCKER_NETWORK=supersrt-network

# --------------------------------------------
# Monitoring & Telemetry
# --------------------------------------------
ENABLE_METRICS=false
ENABLE_TRACING=false
METRICS_PORT=9090
SENTRY_DSN=
ENABLE_ANALYTICS=false
ANONYMOUS_USAGE=false

# --------------------------------------------
# Notifications
# --------------------------------------------
ENABLE_NOTIFICATIONS=false
NOTIFICATION_EMAIL=
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_DISCORD_WEBHOOK=

# --------------------------------------------
# Storage Configuration
# --------------------------------------------
STORAGE_BACKEND=local  # Options: local, s3, gcs, azure
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --------------------------------------------
# Temporal/Queue Configuration (Future)
# --------------------------------------------
ENABLE_QUEUE=false
QUEUE_TYPE=redis  # Options: redis, rabbitmq, sqs
QUEUE_URL=
QUEUE_BATCH_SIZE=100
